# MongoDB Atlas connection string (or local MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27017/sharetable

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# API
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DEFAULT_RADIUS_KM=2.5
RESCUE_RADIUS_LEVELS=2.5,4,6
ESCALATION_MINUTES=20,40
DEMO_MODE=false
PATTERN_MIN_DONATIONS=5

# Optional: food images (presigned PUT to S3)
AWS_REGION=ap-south-1
S3_BUCKET=
PHOTO_CLOUDFRONT_URL=

# Amazon Bedrock (Nova Micro via Converse). Leave empty to disable AI helpers.
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# EventBridge rescue tick. Required for POST /api/internal/rescue-tick
INTERNAL_TICK_SECRET=

# local | ap-runner
RUNTIME=local

# Frontend (production builds). Leave unset in local `npm run dev` so the Vite /api proxy is used.
VITE_API_URL=

# Email verification (SMTP). Gmail needs a 16-character App Password, not your login password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShareTable <you@gmail.com>
